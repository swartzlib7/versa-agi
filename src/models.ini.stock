google/gemini-3.7-flash       = cloud|openrouter|true|true|0|1048576|balanced|text,image,audio,video|text|true|Gemini 3.7 Flash
openai/gpt-5.6-terra          = cloud|openrouter|true|true|0|1050000|balanced|text,image|text|true|GPT-5.6 Terra
anthropic/claude-opus-4.8     = cloud|openrouter|true|true|0|1000000|reasoning|text,image|text|true|Claude Opus 4.8
openai/gpt-5.6-sol            = cloud|openrouter|true|true|0|1050000|reasoning|text,image|text|true|GPT-5.6 Sol
deepseek/deepseek-v4-flash-0731 = cloud|openrouter|true|true|0|1310720|code|text|text|true|DeepSeek V4 Flash 0731
openai/gpt-5.6-luna           = cloud|openrouter|true|true|0|1050000|balanced|text,image|text|true|GPT-5.6 Luna — Multimodal agent model
z-ai/glm-5.2                 = cloud|openrouter|true|true|0|1048576|code|text|text|true|Z.ai: GLM 5.2 — Code-focused, 1M context
# Local AI — provider col regenerated by migrate from setup.ini gpu_backend
# (standard→ollama, intel→llamacpp). Shipped template matches setup.ini (intel).
qwen3.6:35b                   = local|llamacpp|true|false|32768|131072|local|text,image|text|false|Qwen 3.6 35B — MoE reasoning, 128K context
qwen3.8:27b                   = local|llamacpp|true|false|32768|262144|local|text,image|text|false|Qwen 3.8 27B — hybrid thinking, 256K context
gemma4:26b                    = local|llamacpp|true|false|32768|262144|local|text|text|false|Gemma 4 26B — MoE (4B active), 256K context
gemma4:e4b                    = local|llamacpp|true|false|32768|131072|local|text|text|false|Gemma 4 E4B — Edge optimized, 128K context
gemma4:e2b                    = local|llamacpp|true|false|16384|131072|local|text|text|false|Gemma 4 E2B — Edge ultra-light, 128K context
gemma4:31b                    = local|llamacpp|true|false|32768|262144|local|text|text|false|Gemma 4 31B — Dense flagship, 256K context
