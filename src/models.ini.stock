flux1-dev                     = local|local_media|true|false|0|0|local|text|image|false|FLUX.1-dev — Local sd-cli paint

# ─────────────────────────────────────────────────
# Unified Model Catalog — USER LAYER (owned by `agictl model catalog` / the dashboard)
# Overlays [catalog] per key (whole-row override). Never touched by migrate.
# Disabling a baseline model writes a here-override with enabled=false.
# ─────────────────────────────────────────────────

# ─────────────────────────────────────────────────
# Unified Model Catalog — BASELINE (injected by `agictl model migrate`)
# key = class|provider|enabled|coa_approved|ctx_recommended|ctx_max|work_modality|input_modalities|output_modalities|router_eligible|Display Label
#
# EMPTY in stock on purpose. Migrate copies rows from [catalog_library] into
# this section only for enabled providers (Gemini credentials, TP *_enabled,
# or local_ai + hybrid/local mode). Add/override via [catalog_custom].
# ─────────────────────────────────────────────────

[catalog]
# (populated at migrate when a provider / local AI is activated)

# ─────────────────────────────────────────────────
# Unified Model Catalog — USER LAYER (owned by `agictl model catalog` / the dashboard)
# Overlays [catalog] per key (whole-row override). Never touched by migrate.
# ─────────────────────────────────────────────────

[catalog_custom]

# ─────────────────────────────────────────────────
# Catalog removals — USER LAYER (Model Manager / catalog remove)
# Keys listed here are skipped by migrate even if they remain in setup.ini CSVs
# after a stock-list reconcile. Re-adding the model clears the row.
# ─────────────────────────────────────────────────

[catalog_removed]

# ─────────────────────────────────────────────────
# Catalog Pricing — USER LAYER (OpenRouter API enrichment, TD-COST-001)
# key = prompt_per_m|completion_per_m|image_per_m|reasoning_per_m|cache_read_per_m|fetched_at
# USD per million tokens (list rates). Populated by `agictl model openrouter patch-template`
# for all non-local catalog keys (direct API + OpenRouter), best-effort OR ID match.
# Never touched by `agictl model migrate`.
# ─────────────────────────────────────────────────

[catalog_pricing]

# ─────────────────────────────────────────────────
# Model Parameters — BASELINE (shipped defaults)
# Keys: default | model:<catalog_key>
# JSON: temperature, reasoning_effort, reasoning_max_tokens, extra,
#       allowed_reasoning_efforts (required per model for UI + harness clamping)
# Customize via agictl model params (writes [model_params_custom]).
# ─────────────────────────────────────────────────

[model_params]
default = {"temperature":0.2,"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}
# Cloud — Google Gemini
model:gemini-2.5-pro                = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
model:gemini-2.5-flash              = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
model:gemini-3-flash-preview        = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
model:gemini-3.1-pro-preview        = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
model:gemini-3.1-flash-lite         = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
# Third-party — xAI
model:grok-4.5                      = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
# Third-party — OpenAI
model:gpt-5.5-2026-04-23            = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
model:gpt-5.4-2026-03-05            = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
model:gpt-5.4-mini-2026-03-17       = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
# Third-party — Anthropic (Opus 4.7+ / Fable 5 reject temperature — steer via effort / prompting)
model:claude-fable-5                = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max","xhigh"]}
model:claude-opus-4-8               = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max","xhigh"]}
model:claude-sonnet-4-6             = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
# Third-party — OpenRouter
model:x-ai/grok-4.5                 = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","max"]}
model:google/gemini-3-flash-preview = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high"]}
model:moonshotai/kimi-k2.7-code    = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","xhigh"]}
model:deepseek/deepseek-v4-flash   = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","xhigh"]}
model:deepseek/deepseek-v4-pro     = {"reasoning_effort":"none","allowed_reasoning_efforts":["none","minimal","low","medium","high","xhigh"]}
model:z-ai/glm-5.2                 = {"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}
# Local
model:qwen3.6:35b                   = {"reasoning_effort":"none","think_mode":"boolean","allowed_reasoning_efforts":["none","low","medium","high"],"extra":{"top_p":0.95,"top_k":20,"repeat_penalty":1,"presence_penalty":1.5}}
model:qwen3.8:27b                   = {"reasoning_effort":"none","think_mode":"boolean","allowed_reasoning_efforts":["none","low","medium","high"],"extra":{"top_p":0.80,"top_k":20,"repeat_penalty":1,"presence_penalty":1.5}}
model:gemma4:26b                    = {"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}
model:gemma4:e4b                    = {"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}
model:gemma4:e2b                    = {"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}
model:gemma4:31b                    = {"reasoning_effort":"none","allowed_reasoning_efforts":["none"]}

# ─────────────────────────────────────────────────
# Model Parameters — USER LAYER (owned by CLI / dashboard)
# Overlays [model_params] per key. Never touched by migrate.
# ─────────────────────────────────────────────────

[model_params_custom]
# USER OVERRIDES — written by `agictl model params set` and Model Manager → Edit Model.
# Merge onto baseline [model_params]; omit a key to inherit from the layer below.
#
# Examples:
#   model:qwen3.6:35b = {"reasoning_effort":"high","extra":{"top_p":0.95,"top_k":20}}
#   model:deepseek/deepseek-v4-flash = {"reasoning_effort":"medium","allowed_reasoning_efforts":["none","low","medium","high","xhigh"]}
#   model:claude-opus-4-8 = {"reasoning_effort":"high"}
#     (Opus 4.7+ — no temperature; harness maps effort → Anthropic adaptive thinking)
#
# Clear one model layer:  agictl model params clear model:<catalog_key>

# ═════════════════════════════════════════════════
# LOCAL PIPELINE SEED — [local_models] (labels) + [context_windows] + [sycl_models]
# remain owned by the local-model pipeline / registry and are consumed by
# `agictl model migrate` to derive the LOCAL [catalog] rows. Cloud/third-party
# metadata now lives SOLELY in [catalog] above — there are no parallel
# [models]/[third_party_models] sections.
# To onboard a shipped CLOUD/third-party model: add its key to the relevant
# setup.ini list AND a [catalog] row above, then run `setup.sh --update`.
# ═════════════════════════════════════════════════

[local_models]
qwen3.6:35b               = Qwen 3.6 35B — MoE reasoning, 128K context
qwen3.8:27b               = Qwen 3.8 27B — hybrid thinking, 256K context
gemma4:26b                = Gemma 4 26B — MoE (4B active), 256K context
gemma4:e4b                = Gemma 4 E4B — Edge optimized, 128K context
gemma4:e2b                = Gemma 4 E2B — Edge ultra-light, 128K context
gemma4:31b                = Gemma 4 31B — Dense flagship, 256K context

# ─────────────────────────────────────────────────
# Context Windows (tokens)
# Format: model_key = recommended_num_ctx,max_num_ctx
#
# recommended = operational default (balances quality vs VRAM)
# max         = model's actual capacity ceiling
#
# Cloud models: recommended=0 (managed server-side), max=actual limit (for trimmer)
# Local models without entry: defaults to 4096 (Ollama default)
#
# Updated via: agictl model add (auto-registers known models)
# ─────────────────────────────────────────────────

[context_windows]
# Per-model cloud/third-party context windows now live SOLELY in [catalog]
# (ctx_recommended,ctx_max columns). This section keeps only the conservative
# generic prefix fallbacks (for unseen cloud variants) plus the pipeline-owned
# local-model entries. model_context.py reads [catalog] as authoritative and
# overlays this section underneath to fill gaps.

# Generic Cloud Fallbacks (prefix matching — conservative)
gemini                    = 0,1000000
grok                      = 0,1000000
gpt                       = 0,131072
claude                    = 0,200000

# Qwen 3 family
qwen3.6:35b  = 32768,131072
qwen3.8:27b  = 32768,262144

# Gemma 4 family
gemma4:26b   = 32768,262144
gemma4:e4b   = 32768,131072
gemma4:e2b   = 16384,131072
gemma4:31b   = 32768,262144

# ─────────────────────────────────────────────────
# SYCL Model Registry (Intel ARC / llama-server)
#
# Format: model_key = hf_repo,gguf_filename,size_gb
#
# hf_repo   — HuggingFace repository for GGUF download
# gguf_file — Exact filename to download and load
# size_gb   — Approximate GGUF file size in GB (used for concurrency calculation)
#
# The max usable context is computed dynamically at setup time from:
#   Available VRAM = Total GPU VRAM - Model GGUF Size
#   Usable Context = f(Available VRAM, Parallel Slots, KV cache per token)
#
# Managed via: agictl model registry add/update/remove
#         or: ./manage_registry.sh (interactive)
# ─────────────────────────────────────────────────

[sycl_models]
gemma4:e4b   = unsloth/gemma-4-E4B-it-GGUF,gemma-4-E4B-it-Q4_K_M.gguf,5
gemma4:26b   = unsloth/gemma-4-26B-A4B-it-GGUF,gemma-4-26B-A4B-it-UD-Q4_K_M.gguf,16
gemma4:31b   = unsloth/gemma-4-31B-it-GGUF,gemma-4-31B-it-Q4_K_M.gguf,18
qwen3.6:35b  = unsloth/Qwen3.6-35B-A3B-GGUF,Qwen3.6-35B-A3B-UD-Q4_K_M.gguf,21
qwen3.8:27b  = unsloth/Qwen3.8-27B-GGUF,Qwen3.8-27B-UD-Q6_K_XL.gguf,23

# Inspect/import classification + Hub provenance. Keep [sycl_models] at 3 CSV fields.
# User-imported keys are union-preserved by reconcile-config.
[sycl_model_meta]

# Local Utility media bundles (TD-LOCAL-MEDIA-001). Never a [sycl_models] row.
[media_bundles]

