# ─────────────────────────────────────────────────
# Versa AGi — Model Registry (STOCK TEMPLATE)
# ─────────────────────────────────────────────────
# Authority for stock catalog metadata on EVERY install and --update.
# setup.sh scaffolds models.ini from this file when missing; reconcile-config
# regenerates /etc/versa-agi/models.ini from it (user layers preserved).
# Do not put custom/dashboard edits here — those live in [catalog_custom] etc.
#
[providers]           — Provider registry baseline
#   [catalog_library]     — Stock metadata for all known models (not live UI)
#   [catalog]             — Live baseline; migrate injects only activated providers
#
#   USER LAYER (owned by the CLI / dashboard — never touched by migrate):
#   [providers_custom]    — Added/overridden providers
#   [catalog_custom]      — Added/overridden models
#   [catalog_removed]     — Operator-removed keys; migrate skips these
#
#   The loaders merge USER over BASELINE per key (whole-row override). So
#   setup.ini edits propagate via the baseline, while CLI/dashboard edits in the
#   custom layer always survive and win.
#
#   MODEL PARAMS (generation defaults — temperature, reasoning, passthrough):
#   [model_params]        — Baseline defaults (regenerated from template)
#   [model_params_custom] — User overrides (CLI / dashboard; never touched by migrate)
#   Keys: default | model:<catalog_key>
#   Value: JSON object, e.g. {"temperature":0.2,"reasoning_effort":"none"}
#           or {"reasoning_effort":"high","extra":{"top_p":0.9}}
#           or {"allowed_reasoning_efforts":["none","low","high","xhigh"]}
#           or {"think_mode":"boolean","extra":{"top_p":0.95,"top_k":20}}
#
#   Pipeline (three layers — config vs adapter):
#
#     models.ini JSON  →  normalized params  →  to_native_kwargs()  →  LangChain / API
#          (data)              (stable)              (adapter code)
#
#   - Data: [model_params] + [model_params_custom] + optional agents.db overrides.
#   - Stable vocabulary: temperature, reasoning_effort, reasoning_max_tokens,
#     allowed_reasoning_efforts, think_mode, extra (passthrough bag).
#   - Adapter: harness/model_params.py to_native_kwargs() — provider-family translation
#     only; API quirks (e.g. Opus 4.7+ no temperature) live here, not in INI rows.
#   - TD-PARAM-001 (backlog): catalog param_profile to move adapter rules into data.
#
#   think_mode (provider=ollama only — ignored on llamacpp):
#           boolean | levels — maps reasoning_effort → ChatOllama reasoning (Ollama think API)
#   Local catalog rows use provider ``ollama`` (ChatOllama) or ``llamacpp`` (ChatOpenAI
#   → llama-server). ``agictl model migrate`` assigns the slug from setup.ini gpu_backend.
#   On topology=client, gpu_backend describes the remote server's stack; paths.env
#   VERSA_GPU_BACKEND=remote is connectivity only.
#   Each catalog model should declare allowed_reasoning_efforts in model:<key>.
#   Agent overrides (agents.db) inherit from model → default layers.
#
#   LOCAL PIPELINE (owned by the local-model pipeline / registry — not by sync):
#   [local_models]        — Local AI model display labels (Ollama / SYCL)
#   [context_windows]     — Local context windows + conservative cloud prefixes
#   [sycl_models]         — Intel SYCL GGUF registry (repo,file,size_gb) — keep 3 fields
#   [sycl_model_meta]     — JSON sidecar per SYCL key (class, source, revision, hash)
#                            union-preserved on reconcile; never a 4th CSV field
#   [media_bundles]       — local Utility media inventory (JSON); not llama-server
#
#   Remote metadata lives in [catalog_library]. Live [catalog] is generated:
#   shipped keys for enabled providers plus selected / custom / referenced keys.
#
# Format:
#   [providers*]       slug = enabled|Display Name|langchain_class
#   [catalog*]         key  = class|provider|enabled|coa_approved|ctx_recommended|ctx_max|work_modality|input_modalities|output_modalities|router_eligible|Display Label
#                            class ∈ {cloud, local}  (legacy third_party → cloud)
#                            work_modality ∈ {fast, balanced, reasoning, code, local}
#                            input/output_modalities: CSV of text,image,audio,video
#   [local_models]     key = Display Label
#   [context_windows]  key = recommended,max
#   [sycl_models]      key = hf_repo,gguf_filename,size_gb
#   [sycl_model_meta]  key = JSON {class,runtime,source,repo,file,revision,sha256}
#   [media_bundles]    key = JSON {recipe,provider,runtime,source,components}
#
# Cloud models have ctx_recommended = 0 (managed server-side); ctx_max drives the
# harness trim budget. Local models without a context window default to 4096.
#
# Managed via: agictl model catalog add/update/remove   (writes [catalog_custom])
#              agictl provider add/enable/disable/remove (writes [providers_custom])
#              agictl model migrate                      (regenerate baseline from setup.ini)
#              agictl model sync                         (regenerate derived sections + paths.env)
#              agictl model registry add/update/remove   (SYCL GGUF metadata; legacy alias)
#         or: ./manage_registry.sh (interactive)
# ─────────────────────────────────────────────────

# ─────────────────────────────────────────────────
# Provider Registry — BASELINE (regenerated from setup.ini by `agictl model migrate`)
# slug = enabled|Display Name|langchain_class
#
# DO NOT hand-edit — changes here are overwritten on the next `setup.sh` run.
# Add or override providers via `agictl provider …` (writes [providers_custom]).
#
# `enabled` is non-secret. The API key lives in setup.ini [third_party].{slug}_api_key
# (or the Gemini key for google). A third-party model is available at runtime only
# when its model row is enabled AND its provider is enabled AND a key is present.
# ─────────────────────────────────────────────────

# ─────────────────────────────────────────────────
# Shipped selection — SYSTEM (replaced on every --update)
# offering_id = {"label":"…","keys":{"provider":"catalog_key",…}}
# File order is the first-login picker order. Not a COA list.
# ─────────────────────────────────────────────────

[shipped_models]
grok-4.6 = {"label":"Grok 4.6","keys":{"openrouter":"x-ai/grok-4.6","xai":"grok-4.6"}}
gemini-3.7-flash = {"label":"Gemini 3.7 Flash","keys":{"openrouter":"google/gemini-3.7-flash","google":"gemini-3.7-flash"}}
gpt-5.6-terra = {"label":"GPT-5.6 Terra","keys":{"openrouter":"openai/gpt-5.6-terra","openai":"gpt-5.6-terra"}}
claude-opus-4-8 = {"label":"Opus 4.8","keys":{"openrouter":"anthropic/claude-opus-4.8","anthropic":"claude-opus-4-8"}}
gpt-5.6-sol = {"label":"GPT-5.6 Sol","keys":{"openrouter":"openai/gpt-5.6-sol","openai":"gpt-5.6-sol"}}
glm-5.2 = {"label":"GLM 5.2","keys":{"openrouter":"z-ai/glm-5.2"}}
deepseek-v4-flash-0731 = {"label":"DeepSeek V4Flash0731","keys":{"openrouter":"deepseek/deepseek-v4-flash-0731"}}
gpt-5.6-luna = {"label":"GPT-5.6 Luna","keys":{"openrouter":"openai/gpt-5.6-luna","openai":"gpt-5.6-luna"}}

# ─────────────────────────────────────────────────
# Provider presets — SYSTEM (replaced on every --update)
# slug = class|label|langchain_class|transport|auth_adapter|endpoint
# enabled/credentials are not stored here.
# ─────────────────────────────────────────────────

[provider_library]
google = cloud|Google|ChatGoogleGenerativeAI|direct|google_gemini|
xai = cloud|xAI|ChatOpenAI|openai_compat|openai_key|https://api.x.ai/v1
openai = cloud|OpenAI|ChatOpenAI|openai_compat|openai_key|https://api.openai.com/v1
anthropic = cloud|Anthropic|ChatAnthropic|anthropic|anthropic_key|
openrouter = cloud|OpenRouter|ChatOpenAI|openai_compat|openai_key|https://openrouter.ai/api/v1
ollama = local|Local (Ollama)|ChatOllama|ollama|local|
llamacpp = local|Local (llama.cpp / SYCL)|ChatOpenAI|llamacpp|local|
local_media = local|Local media (sd-cli)||local_media|local|

[providers]
# Generated live baseline — migrate rewrites enabled from providers_site ∩ credentials.
google    = false|Google|ChatGoogleGenerativeAI
xai       = false|xAI|ChatOpenAI
openai    = false|OpenAI|ChatOpenAI
anthropic = false|Anthropic|ChatAnthropic
openrouter = false|OpenRouter|ChatOpenAI
ollama    = false|Local (Ollama)|ChatOllama
llamacpp  = false|Local (llama.cpp / SYCL)|ChatOpenAI
local_media = false|Local media (sd-cli)|

[providers_site]
# SITE — enabled= CSV of provider slugs the operator turned on.
enabled=

[provider_custom]
# SITE — full records for providers not in [provider_library].

[provider_overrides]
# SITE — sparse JSON patches for system provider cards.

# ─────────────────────────────────────────────────
# Provider Registry — USER LAYER (owned by `agictl provider` / the dashboard)
# Overlays [providers] per slug. Never touched by `agictl model migrate`.
# ─────────────────────────────────────────────────

[providers_custom]

# ─────────────────────────────────────────────────
# Catalog Library — STOCK METADATA (not live Models tab)
# Full row format matches [catalog]. `agictl model migrate` reads this for
# labels/context when injecting models for *activated* providers only.
# Live [catalog] stays empty until Google / TP / Local AI is configured.
# ─────────────────────────────────────────────────

[catalog_library]
