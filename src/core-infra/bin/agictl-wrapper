#!/bin/bash
# ─────────────────────────────────────────────────────
# agictl — Wrapper for transparent sudo elevation
#
# When called by an agent user (e.g. coa), automatically
# re-executes as the watchdog user via sudo. This ensures
# the agent can never directly access the SQLite database.
#
# The actual binary lives at /usr/local/lib/versa-agi/agictl
# and is the only command the agent is allowed to sudo.
# ─────────────────────────────────────────────────────

REAL_BINARY="/usr/local/lib/versa-agi/agictl"

# --version before sudo elevation (same VERSION file as setup.sh / agitop).
for _arg in "$@"; do
  case "${_arg}" in
    --version|-V)
      _paths_env="/etc/versa-agi/paths.env"
      [ -f "${_paths_env}" ] && . "${_paths_env}"
      _core="${VERSA_CORE_INFRA:-/home/watchdog/core-infra}"
      _ver="${VERSA_PRODUCT_VERSION:-}"
      if [ -z "${_ver}" ]; then
        for _vf in \
            "${_core}/VERSION" \
            "/home/watchdog/core-infra/VERSION" \
            "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/VERSION"; do
          if [ -f "${_vf}" ]; then
            _ver="$(tr -d '[:space:]' < "${_vf}")"
            break
          fi
        done
      fi
      echo "agictl ${_ver:-unknown}"
      exit 0
      ;;
    --) break ;;
  esac
done

# Determine if the caller is an agent user
CALLER="$(whoami)"

# ── Auto-detect defaults when env vars are not set ──
# Agent OS users are coa, watchdog, root, or agi-{logical_name}.
# Logical name (web-dev, not agi-web-dev) is used for *_config.json and
# /var/lib/versa-agi/{name}/. The Primary User (any other account) falls
# through to COA defaults. The calling user (s7) can't stat those paths,
# but watchdog (the sudo elevation target) can.

_is_agent_user=false
case "${CALLER}" in
  coa|watchdog|root|agi-*) _is_agent_user=true ;;
esac

_logical="${CALLER}"
case "${CALLER}" in
  agi-*) _logical="${CALLER#agi-}" ;;
esac

if [ -z "${VERSA_AGENT_NAME:-}" ]; then
  case "${CALLER}" in
    agi-*) export VERSA_AGENT_NAME="${_logical}" ;;
  esac
fi

if [ -z "${AGICTL_CONFIG:-}" ]; then
  if [ "${_is_agent_user}" = true ] && [ -f "/etc/versa-agi/${_logical}_config.json" ]; then
    export AGICTL_CONFIG="/etc/versa-agi/${_logical}_config.json"
  else
    export AGICTL_CONFIG="/etc/versa-agi/coa_config.json"
  fi
fi
if [ -z "${AGICTL_DB:-}" ]; then
  if [ "${_is_agent_user}" = true ] && [ -f "/var/lib/versa-agi/${_logical}/agent_memory.db" ]; then
    export AGICTL_DB="/var/lib/versa-agi/${_logical}/agent_memory.db"
  else
    export AGICTL_DB="/var/lib/versa-agi/coa/agent_memory.db"
  fi
fi
if [ -z "${AGICTL_AGENT_DIR:-}" ]; then
  _found=""
  if [ "${_is_agent_user}" = true ]; then
    for _d in "${HOME}/.agent" "${HOME}"/*/.agent; do
      if [ -d "${_d}" ]; then
        export AGICTL_AGENT_DIR="${_d}"
        _found=1
        break
      fi
    done
  fi
  if [ -z "${_found}" ]; then
    export AGICTL_AGENT_DIR="/home/coa/coa-env/.agent"
  fi
fi

# If running as root or watchdog, execute directly
if [ "${CALLER}" = "root" ] || [ "${CALLER}" = "watchdog" ]; then
  exec "${REAL_BINARY}" "$@"
fi

# For any other user (agent users), elevate to watchdog via sudo.
# Explicitly forward identity + DB env — sudo strips the environment.
exec sudo -u watchdog \
  AGICTL_DB="${AGICTL_DB:-}" \
  AGICTL_AGENT_DIR="${AGICTL_AGENT_DIR:-}" \
  AGICTL_CONFIG="${AGICTL_CONFIG:-}" \
  AGICTL_AGENT_USER="${CALLER}" \
  AGICTL_AGENTS_DB="${AGICTL_AGENTS_DB:-}" \
  AGICTL_MESSAGES_DB="${AGICTL_MESSAGES_DB:-}" \
  AGICTL_TASKS_DB="${AGICTL_TASKS_DB:-}" \
  AGICTL_CYCLES_DB="${AGICTL_CYCLES_DB:-}" \
  VERSA_AGENT_NAME="${VERSA_AGENT_NAME:-}" \
  VERSA_CYCLE_ID="${VERSA_CYCLE_ID:-}" \
  "${REAL_BINARY}" "$@"
