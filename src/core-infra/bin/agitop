#!/bin/bash
# ─────────────────────────────────────────────────────
# agitop — Versa AGi Mission Control Dashboard Launcher
#
# Launches the Python Textual TUI dashboard.
# Reads data from SQLite, status.json, system_config,
# CRON state, and system resources. Read-only observer.
#
# Usage:
#   agitop [--db <path>] [--config <path>] [--status <path>]
#
# Runs as the current user with sudo for DB access.
# ─────────────────────────────────────────────────────

set -euo pipefail

# ─── Enforce sudo ────────────────────────────────
if [ "$(id -u)" -ne 0 ]; then
    echo "agitop requires sudo for access to system files."
    echo "Usage: sudo agitop"
    exit 1
fi

# ─── Resolve paths ───────────────────────────────
# Source INI-derived paths (generated by setup.sh)
PATHS_ENV="/etc/versa-agi/paths.env"
if [ -f "${PATHS_ENV}" ]; then
  source "${PATHS_ENV}"
fi

CORE_INFRA="${VERSA_CORE_INFRA:-/home/watchdog/core-infra}"
AGITOP_DIR="${CORE_INFRA}/agitop"

# Verify the agitop module exists
if [ ! -d "${AGITOP_DIR}" ]; then
  echo "ERROR: agitop module not found at ${AGITOP_DIR}" >&2
  echo "Run the setup script to deploy agitop." >&2
  exit 1
fi

# Default paths (can be overridden via CLI args)
AGENTS_DB_PATH="/var/lib/versa-agi/agents.db"
MESSAGES_DB_PATH="/var/lib/versa-agi/messages.db"
TASKS_DB_PATH="/var/lib/versa-agi/coa/tasks.db"
CYCLES_DB_PATH="/var/lib/versa-agi/coa/cycles.db"
CONFIG_PATH="/etc/versa-agi/coa_config.json"
CYCLE_ID_PATH="/var/lib/versa-agi/coa/.current_cycle_id"
ORGANIZATION_DB_PATH="/var/lib/versa-agi/organization.db"
# ─── Check Python + Textual ──────────────────────
PYTHON=""
if [ -x "/opt/versa-agi/venv/bin/python3" ]; then
    PYTHON="/opt/versa-agi/venv/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON="python3"
fi

if [ -z "${PYTHON}" ]; then
    echo "ERROR: Python 3 not found" >&2
    exit 1
fi

# Check Textual is installed
if ! ${PYTHON} -c "import textual" 2>/dev/null; then
    echo "ERROR: Textual not installed. Run: pip3 install textual" >&2
    exit 1
fi

# ─── Launch ──────────────────────────────────────
export PYTHONPATH="${CORE_INFRA}:${PYTHONPATH:-}"

exec ${PYTHON} -m agitop.app \
    --agents-db "${AGENTS_DB_PATH}" \
    --messages-db "${MESSAGES_DB_PATH}" \
    --tasks-db "${TASKS_DB_PATH}" \
    --cycles-db "${CYCLES_DB_PATH}" \
    --config "${CONFIG_PATH}" \
    --cycle-id "${CYCLE_ID_PATH}" \
    --organization-db "${ORGANIZATION_DB_PATH}" \
    "$@"
