#!/bin/bash
# Run pinned sd-cli in the Intel SYCL Docker image. Host paths under
# /opt/versa-agi/media-models stay the same inside the container.
set -euo pipefail

if [ -f /etc/versa-agi/sdcpp.env ]; then
  # shellcheck source=/dev/null
  . /etc/versa-agi/sdcpp.env
fi
IMAGE="${VERSA_SDCPP_IMAGE:-versa-agi-sdcpp:master-820-de298c2}"
MEDIA_STORE="${VERSA_MEDIA_STORE:-/opt/versa-agi/media-models}"
OUT_DIR="${VERSA_MEDIA_OUT:-/tmp/versa-agi-media-out}"

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required to run versa-agi-sd-cli on Intel SYCL" >&2
  exit 1
fi
if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
  echo "Missing image ${IMAGE}. On the GPU host run: sudo ./setup.sh --update" >&2
  exit 1
fi

mkdir -p "${MEDIA_STORE}" "${OUT_DIR}"

DEVICES=""
MOUNTS=""
ENVS=""
if [ -e /dev/dxg ]; then
  DEVICES="--device /dev/dxg"
  if [ -d /usr/lib/wsl ]; then
    MOUNTS="-v /usr/lib/wsl:/usr/lib/wsl"
  fi
else
  for dev in /dev/dri/renderD* /dev/dri/card*; do
    if [ -e "${dev}" ]; then
      DEVICES="${DEVICES} --device ${dev}"
    fi
  done
fi

# shellcheck disable=SC2086
exec docker run --rm \
  ${DEVICES} \
  ${MOUNTS} \
  ${ENVS} \
  -v "${MEDIA_STORE}:${MEDIA_STORE}" \
  -v "${OUT_DIR}:${OUT_DIR}" \
  -w /tmp \
  "${IMAGE}" \
  "$@"
